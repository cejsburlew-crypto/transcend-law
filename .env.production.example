# Production Environment Variables
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:PASSWORD@ENDPOINT:5432/transcend_prod

# Cache
REDIS_URL=redis://ENDPOINT:6379

# URLs
FRONTEND_URL=https://transcend-law.com
BACKEND_URL=https://api.transcend-law.com
API_PORT=3000

# Security
JWT_SECRET=generate_a_random_secure_key_here
JWT_EXPIRES_IN=7d

# Payment Processing
PAYMENT_PROCESSOR_KEY=your_stripe_key_here
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=https://transcend-law.com
