{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./transcend-api/dist",
    "rootDir": "./transcend-api/src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "allowJs": true
  },
  "include": ["transcend-api/src/**/*"],
  "exclude": ["node_modules", "transcend-frontend", "**/*.test.ts"]
}
