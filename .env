# Transcend Law Environment Configuration

# ============================================
# API SERVER
# ============================================
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ============================================
# DATABASE
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transcend_prod
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# ============================================
# PAYMENT PROCESSING - CLOVER
# ============================================
CLOVER_API_KEY=your_clover_api_key_here
CLOVER_MERCHANT_ID=your_merchant_id_here
CLOVER_WEBSITE_ITEM_ID=lawyer_website_monthly
CLOVER_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# AWS S3 FILE STORAGE
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=transcend-legal-documents

# ============================================
# ADMIN SYSTEMS - REQUEST PANEL & HEALTH CHECK
# ============================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=300000
SLOW_ENDPOINT_THRESHOLD=2000

# ============================================
# SECURITY SCAN & THREAT REPORTING (OPTIONAL)
# ============================================
GOOGLE_SAFE_BROWSING_KEY=your_key_here_or_skip
AWS_GUARDDUTY_ENABLED=false
VIRUSTOTAL_API_KEY=your_key_here_or_skip

# ============================================
# NOTIFICATION SERVICES (OPTIONAL)
# ============================================
SLACK_WEBHOOK_URL=your_webhook_url_here_or_skip
SENDGRID_API_KEY=your_sendgrid_key_here_or_skip

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_LAWYER_WEBSITES=true
ENABLE_ADMIN_PANEL=true
ENABLE_HEALTH_CHECK=true
ENABLE_SECURITY_SCAN=true

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_LOGGING=true
