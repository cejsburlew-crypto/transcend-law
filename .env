# TRANSCEND LAW - PRODUCTION ENVIRONMENT
# Default admin credentials (temporary for initial setup)

NODE_ENV=production
PORT=3000

# Domain Configuration
DOMAIN=transcendlaw.com
APP_URL=https://transcendlaw.com
API_URL=https://api.transcendlaw.com

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transcend_law
DB_USER=postgres
DB_PASSWORD=secure_password_change_this

# Default Admin Credentials
ADMIN_EMAIL=cejsburlew@gmail.com
ADMIN_PASSWORD_HASH=$2b$10$5c5c5c5c5c5c5c5c5c5c5cNJZeL.7xKKKKKKKKKKKKKK
ADMIN_USERNAME=admin

# Payment Processing
STRIPE_API_KEY=sk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Notifications
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxx
SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# Security
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRY=7d
BCRYPT_ROUNDS=10

# API Security
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# Features
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_USER_LOGIN=false
MAINTENANCE_MODE=true

# Logging
LOG_LEVEL=info
