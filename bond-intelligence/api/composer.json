{
    "name": "transcend-pm/bond-intelligence-api",
    "description": "Bond Intelligence Scraper API - CodeIgniter 4",
    "type": "project",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.5",
        "league/csv": "^9.0"
    },
    "require-dev": {
        "codeigniter4/devkit": "^1.0",
        "fakerphp/faker": "^1.9",
        "kint-php/kint": "*",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "CodeIgniter\\ComposerScripts::postUpdate"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "codeigniter4/devkit": true,
            "phpstan/extension-installer": true
        }
    }
}
