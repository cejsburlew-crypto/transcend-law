DB_PATH=../api/writable/bond_intelligence.db

# Polite scraping
REQUEST_DELAY_SECONDS=2
USER_AGENT=BondIntelligenceScraper/1.0 (Transcend PM research tool; contact: jim.burlew@jbca-inc.com)

# Playwright
PLAYWRIGHT_HEADLESS=true

# Scheduler (cron-style)
CDIAC_SCHEDULE=0 2 * * 1
TX_BRB_SCHEDULE=0 3 * * 1
BALLOTPEDIA_SCHEDULE=0 4 * * 1
PROCUREMENT_SCHEDULE=0 1 * * *

# Optional proxy
# HTTP_PROXY=http://proxy:8888
