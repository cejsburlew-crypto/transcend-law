{
  "scripts": {
    "build": "tsc --skipLibCheck --noImplicitAny false",
    "dev": "ts-node transcend-api/src/index.ts",
    "start": "node transcend-api/dist/index.js",
    "typecheck:api": "tsc --noEmit -p transcend-api/tsconfig.json",
    "typecheck:frontend": "tsc -b transcend-frontend --force",
    "typecheck": "npm run typecheck:api && npm run typecheck:frontend:ratchet",
    "test": "jest",
    "test:api": "jest --selectProjects api",
    "test:frontend": "jest --selectProjects frontend",
    "lint": "eslint transcend-api transcend-frontend/src",
    "lint:changed": "node scripts/lint-changed.mjs",
    "test:api:gate": "jest --selectProjects api --testPathPatterns \"(features|integration|routeAuth|encryption|translationEgress)\\.test\\.ts$\"",
    "typecheck:frontend:ratchet": "node scripts/typecheck-ratchet.mjs"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@vercel/node": "^3.0.0",
    "aws-sdk": "^2.1500.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.0.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.33.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^9.0.5",
    "papaparse": "^5.6.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.3",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "speakeasy": "^2.0.0",
    "stripe": "^22.5.0",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.7",
    "@types/node": "^26.2.0",
    "@types/node-schedule": "^2.1.8",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "geoip-lite": "^1.4.10",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
