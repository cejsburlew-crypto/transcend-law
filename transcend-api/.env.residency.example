# Data Residency Configuration
# Regional database endpoints and encryption settings

# ============================================
# REGIONAL DATABASE ENDPOINTS
# ============================================

# US East (Virginia)
DB_US_EAST_HOST=transcend-us-east-1.database.aws.amazon.com
DB_US_EAST_PORT=5432
DB_US_EAST_NAME=transcend_law_us_east
DB_US_EAST_USER=transcend_admin
DB_US_EAST_PASSWORD=your-secure-password-us-east

# EU (Ireland)
DB_EU_WEST_HOST=transcend-eu-west-1.database.aws.amazon.com
DB_EU_WEST_PORT=5432
DB_EU_WEST_NAME=transcend_law_eu_west
DB_EU_WEST_USER=transcend_admin
DB_EU_WEST_PASSWORD=your-secure-password-eu-west

# UK (London)
DB_UK_WEST_HOST=transcend-uk-west-2.database.aws.amazon.com
DB_UK_WEST_PORT=5432
DB_UK_WEST_NAME=transcend_law_uk_west
DB_UK_WEST_USER=transcend_admin
DB_UK_WEST_PASSWORD=your-secure-password-uk-west

# Canada (Toronto)
DB_CA_CENTRAL_HOST=transcend-ca-central-1.database.aws.amazon.com
DB_CA_CENTRAL_PORT=5432
DB_CA_CENTRAL_NAME=transcend_law_ca_central
DB_CA_CENTRAL_USER=transcend_admin
DB_CA_CENTRAL_PASSWORD=your-secure-password-ca-central

# ============================================
# ENCRYPTION KEY MANAGEMENT
# ============================================

# AWS KMS Key ARNs for regional encryption
KMS_KEY_US_EAST_ARN=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012
KMS_KEY_EU_WEST_ARN=arn:aws:kms:eu-west-1:123456789012:key/12345678-1234-1234-1234-123456789012
KMS_KEY_UK_WEST_ARN=arn:aws:kms:uk-west-2:123456789012:key/12345678-1234-1234-1234-123456789012
KMS_KEY_CA_CENTRAL_ARN=arn:aws:kms:ca-central-1:123456789012:key/12345678-1234-1234-1234-123456789012

# Encryption algorithm (AES-256 recommended)
ENCRYPTION_ALGORITHM=AES-256-GCM

# ============================================
# REGIONAL S3 BUCKETS
# ============================================

# Document storage buckets (region-specific)
S3_BUCKET_US_EAST=transcend-documents-us-east-1
S3_BUCKET_EU_WEST=transcend-documents-eu-west-1
S3_BUCKET_UK_WEST=transcend-documents-uk-west-2
S3_BUCKET_CA_CENTRAL=transcend-documents-ca-central-1

# Enable versioning for compliance
S3_VERSIONING_ENABLED=true

# Data retention in days before archival
S3_RETENTION_DAYS_US_EAST=1825
S3_RETENTION_DAYS_EU_WEST=2555
S3_RETENTION_DAYS_UK_WEST=2555
S3_RETENTION_DAYS_CA_CENTRAL=1825

# ============================================
# COMPLIANCE & AUDIT
# ============================================

# Audit logging
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_ENCRYPTION_ENABLED=true

# Compliance reporting
COMPLIANCE_REPORT_FREQUENCY=monthly
COMPLIANCE_REPORT_EMAIL=compliance@transcend-law.com

# Key rotation frequency (in days)
KEY_ROTATION_FREQUENCY_DAYS=90

# Data transfer approval required
DATA_TRANSFER_REQUIRES_APPROVAL=true
DATA_TRANSFER_APPROVAL_EMAIL=legal@transcend-law.com

# ============================================
# REGIONAL SETTINGS
# ============================================

# Default region for users without selection
DEFAULT_REGION=us-east-1

# Enable cross-region replication for backup
REPLICATION_ENABLED=true
REPLICATION_ENDPOINTS=eu-west-1,uk-west-2,ca-central-1

# Data center response time SLA (in milliseconds)
RESPONSE_TIME_SLA_MS=200

# ============================================
# COMPLIANCE FRAMEWORKS
# ============================================

# Enable compliance checking
COMPLIANCE_CHECKING_ENABLED=true

# GDPR compliance (EU regions)
GDPR_ENABLED=true
GDPR_AUDIT_FREQUENCY=quarterly
GDPR_BREACH_NOTIFICATION_HOURS=72

# CCPA compliance (US regions)
CCPA_ENABLED=true
CCPA_AUDIT_FREQUENCY=annually

# PIPEDA compliance (Canada regions)
PIPEDA_ENABLED=true
PIPEDA_AUDIT_FREQUENCY=annually

# UK GDPR compliance (UK region)
UK_GDPR_ENABLED=true
UK_GDPR_AUDIT_FREQUENCY=quarterly

# ============================================
# MONITORING & ALERTS
# ============================================

# Alert on cross-region access attempts
ALERT_CROSS_REGION_ACCESS=true
CROSS_REGION_ACCESS_EMAIL=security@transcend-law.com

# Alert on failed data transfers
ALERT_TRANSFER_FAILURE=true
TRANSFER_FAILURE_EMAIL=ops@transcend-law.com

# Regional data volume thresholds (in GB)
VOLUME_WARNING_THRESHOLD_GB=500
VOLUME_CRITICAL_THRESHOLD_GB=1000

# ============================================
# TESTING & DEVELOPMENT
# ============================================

# Skip encryption in development (NOT for production!)
SKIP_ENCRYPTION_DEV=false

# Mock regional endpoints (for testing)
MOCK_REGIONAL_ENDPOINTS=false

# Verbose logging
VERBOSE_RESIDENCY_LOGGING=false
