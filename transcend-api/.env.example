# Encryption Key Rotation Configuration

# ============================================
# MASTER KEY CONFIGURATION
# ============================================

# Master encryption key (generate with: openssl rand -hex 32)
# CRITICAL: Store securely in AWS KMS, HashiCorp Vault, or similar
# DO NOT commit to version control
ENCRYPTION_MASTER_KEY=<generate with: openssl rand -hex 32>

# Key rotation algorithm
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================
# DATABASE CONFIGURATION
# ============================================

DB_USER=transcend_admin
DB_PASSWORD=<secure password here>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transcend_law

# ============================================
# KEY ROTATION SCHEDULING
# ============================================

# Rotation schedule (cron format: minute hour day month dayOfWeek)
# Monthly on 1st at 2 AM UTC
ROTATION_CRON=0 2 1 * *

# Test schedule (cron format)
# Weekly on Sunday at 3 AM UTC
TEST_CRON=0 3 * * 0

# Enable automatic key rotation
ENABLE_AUTO_ROTATION=true

# Enable automatic testing
ENABLE_AUTO_TESTING=true

# Rotation interval in days (minimum interval between rotations)
ROTATION_INTERVAL_DAYS=30

# Test rotation interval in days
TEST_ROTATION_INTERVAL_DAYS=7

# ============================================
# BATCH PROCESSING
# ============================================

# Number of records to process per batch during re-encryption
# Higher = faster but more memory; Lower = slower but less memory
BATCH_SIZE=1000

# Maximum retries for failed re-encryption operations
MAX_RETRIES=3

# ============================================
# ALERTING
# ============================================

# Email for security alerts
SECURITY_ALERT_EMAIL=security@transcend-law.com

# Enable email alerts on rotation failures
ENABLE_ROTATION_ALERTS=true

# ============================================
# MONITORING
# ============================================

# Enable detailed logging
DEBUG_KEY_ROTATION=false

# Log directory for key rotation operations
LOG_DIR=/var/log/transcend/key-rotation

# ============================================
# AWS KMS (Optional - for master key storage)
# ============================================

# AWS region for KMS
AWS_REGION=us-east-1

# AWS KMS key ID (use instead of ENCRYPTION_MASTER_KEY for production)
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012

# AWS credentials (use IAM roles in production)
# AWS_ACCESS_KEY_ID=<access key>
# AWS_SECRET_ACCESS_KEY=<secret key>

# ============================================
# HASHICORP VAULT (Optional - for master key storage)
# ============================================

# Vault server address
# VAULT_ADDR=https://vault.example.com:8200

# Vault token (use AppRole or other auth in production)
# VAULT_TOKEN=<vault token>

# Vault path for master key
# VAULT_KEY_PATH=secret/data/transcend/encryption-master-key

# ============================================
# TIMEZONE
# ============================================

# Timezone for cron schedules (IANA timezone)
TIMEZONE=UTC

# ============================================
# RETENTION POLICY
# ============================================

# Days to retain archived keys (for compliance/recovery)
# Set to -1 for indefinite retention
ARCHIVED_KEY_RETENTION_DAYS=2555  # ~7 years

# Days to retain rotation job logs
ROTATION_LOG_RETENTION_DAYS=730  # 2 years

# ============================================
# PRODUCTION DEFAULTS
# ============================================

# NODE_ENV=production
# LOG_LEVEL=info
# HTTPS_ONLY=true
# SECURE_COOKIES=true
