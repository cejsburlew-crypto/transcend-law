# Transcend Law Environment Configuration
# Copy to .env and fill in your values

# ============================================
# DATABASE
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=transcend_admin
DB_PASSWORD=your-secure-password-here
DB_NAME=transcend_law

# ============================================
# JWT SECRETS (CHANGE THESE IN PRODUCTION!)
# ============================================
JWT_SECRET=your-jwt-secret-key-minimum-32-characters
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-minimum-32-characters

# ============================================
# SERVER
# ============================================
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://transcend-law.com

# ============================================
# TRANSLATION API
# ============================================
TRANSLATION_PROVIDER=google # google, deepl, azure, aws
GOOGLE_TRANSLATE_API_KEY=your-google-cloud-api-key
GOOGLE_PROJECT_ID=your-google-project-id
DEEPL_API_KEY=your-deepl-api-key
AZURE_TRANSLATOR_KEY=your-azure-key
AWS_REGION=us-east-1

# ============================================
# STRIPE
# ============================================
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================
# TWILIO
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_API_KEY=your-twilio-api-key
TWILIO_API_SECRET=your-twilio-api-secret

# ============================================
# AWS
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=transcend-law-documents
AWS_S3_REGION=us-east-1

# ============================================
# SENDGRID
# ============================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@transcend-law.com

# ============================================
# REDIS (for caching)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/transcend-api.log
