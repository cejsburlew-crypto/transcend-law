{
  "version": 2,
  "buildCommand": "echo 'Skipping build - using pre-built frontend'",
  "outputDirectory": "frontend-dist",
  "installCommand": "echo 'Skipping install'",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/**/*.ts": {
      "memory": 512,
      "maxDuration": 30,
      "runtime": "nodejs20"
    }
  },
  "routes": [
    { "src": "/api/v2/attorneys", "dest": "/api/v2/attorneys.ts", "methods": ["GET"] },
    { "src": "/api/v2/notaries", "dest": "/api/v2/notaries.ts", "methods": ["GET"] }
  ]
}
