{
  "version": 2,
  "buildCommand": "cd transcend-frontend && npm install --legacy-peer-deps && npm run build && cd .. && cp -r transcend-frontend/dist/* .",
  "outputDirectory": ".",
  "installCommand": "npm ci --legacy-peer-deps",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/**/*.ts": {
      "memory": 512,
      "maxDuration": 30,
      "runtime": "nodejs20"
    }
  },
  "routes": [
    { "src": "/api/attorneys", "dest": "/api/attorneys.js" },
    { "src": "/api/notaries", "dest": "/api/notaries.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
